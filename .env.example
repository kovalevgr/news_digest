# Copy to .env (gitignored) and fill in. Compose reads this file.
# Secrets NEVER go in config.yaml or git — only here / the environment.

# ---- Database ----
DB_PASSWORD=change-me
# DATABASE_URL has NO default — app/db/session.py fails fast if it is unset.
# Compose injects it per-service, so you don't set it here. For host/non-Compose runs
# (scripts, one-off tooling) you MUST export it yourself, e.g.:
#   export DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/content_test

# ---- Web editor basic auth (Caddy) ----
# Generate the hash:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# IMPORTANT: Compose interpolates this file, so DOUBLE every '$' in the hash to '$$'
# (e.g. $2a$14$... becomes $$2a$$14$$...). Caddy then receives the correct single-$ hash.
# The value below is a THROWAWAY default (user "owner", password "changeme") so a fresh
# `docker compose up` boots cleanly — REGENERATE it before exposing the editor anywhere.
WEB_AUTH_USER=owner
WEB_AUTH_HASH=$$2a$$14$$vIhUqGoe4/2RhopuFSFYv./ydu5d3VXKoWkSfoYVgp5tvsQiGQjuS
# Caddy site address. Local: ":80" (plain HTTP). Prod: "yourdomain.example" (auto-HTTPS).
SITE_ADDRESS=:80

# ---- Web editor UI (NiceGUI) ----
# NiceGUI signs its per-browser storage cookie with this secret. It is NOT authentication
# (Caddy basic-auth above fronts the whole surface) — only cookie integrity. A blank value
# falls back to an obvious dev placeholder so a fresh local boot works with no setup; set a
# real random value in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
WEB_STORAGE_SECRET=

# ---- LLM transport ----
# generate provider: anthropic | vertex | fake    embed provider: vertex | voyage | fake
# Defaults below are "fake" so a fresh `docker compose up` round-trips with NO external
# credentials (zero-cred boot). Switch each provider on once you have keys/ADC.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
ANTHROPIC_API_KEY=
# Optional role->model overrides (defaults live in app/llm/config.py):
# LLM_MODEL_GENERATION=claude-sonnet-4-6
# LLM_MODEL_GENERATION_HIGH=claude-opus-4-8
# LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
# LLM_MODEL_EMBEDDING=gemini-embedding-001
#
# ---- Real embeddings via Vertex (recommended; no API key, billed to one GCP acct) ----
# Set EMBEDDING_PROVIDER=vertex and the two vars below. Auth is ADC:
#   - Local: `gcloud auth application-default login`; docker-compose.yml mounts
#     ~/.config/gcloud read-only into the poller so the container's default ADC path
#     (/root/.config/gcloud) resolves. No GOOGLE_APPLICATION_CREDENTIALS needed.
#   - Prod VM: the attached service account supplies ADC automatically (no mount, no vars
#     beyond project/location). Grant it Vertex AI permissions.
# gemini-embedding-001 returns dim=1536 in europe-central2 (matches EMBEDDING_DIM).
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=europe-central2
# If user ADC complains about a billing/quota project, pin it explicitly:
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project
# Alternatively point at a service-account key file instead of mounted ADC:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
#
# ---- Embeddings via Voyage (alternative; API key) ----
# EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=

# ---- Telegram (Gate 1 + digest; Phase 2+) ----
TELEGRAM_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Sources (Phase 1+) ----
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
